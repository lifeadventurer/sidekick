root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{py,pyi}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{cmake,CMakeLists.txt}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{sh,bash,zsh}]
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab
