# Copy to .env.local and fill in for your network (file is gitignored).
# Used at build time to generate include/sidekick_device_config.h
#
# Shell exports with the same names override these files, e.g.:
#   export SIDEKICK_BACKEND_HOST=192.168.1.50

# Laptop IP running `go run .` in apps/sidekick/backend (not localhost on the board)
SIDEKICK_BACKEND_HOST=
SIDEKICK_BACKEND_PORT=8787
SIDEKICK_BACKEND_SESSION_ID=sidekick

# Same Wi-Fi the board and Mac join
SIDEKICK_WIFI_SSID=
SIDEKICK_WIFI_PSWD=
