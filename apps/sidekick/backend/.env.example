SIDEKICK_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# RAG memory with OpenAI embeddings
SIDEKICK_RAG_MEMORY_PATH=data/rag_memory.jsonl
SIDEKICK_RAG_MAX_ENTRIES=500
SIDEKICK_RAG_TOP_K=3
SIDEKICK_RAG_MIN_SIMILARITY=0.75
SIDEKICK_RAG_EMBED_PROVIDER=openai
SIDEKICK_RAG_EMBED_MODEL=text-embedding-3-small
# SIDEKICK_RAG_EMBED_URL=https://api.openai.com/v1/embeddings
OPENAI_API_KEY=your_openai_api_key_here
